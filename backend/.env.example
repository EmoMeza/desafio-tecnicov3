# Puerto del servidor HTTP
PORT=3000

# Secreto para firmar los JWT. En un entorno real: valor largo y aleatorio.
JWT_SECRET=dev-secret-cambiame

# Expiración de los tokens (formato de la librería `ms`: 15m, 1h, 7d...)
JWT_EXPIRES_IN=15m

# Origen permitido para CORS (la SPA de Vite en desarrollo)
CORS_ORIGIN=http://localhost:5173
