# Overrides opcionales para `docker compose`.
# Copia a `.env` en esta carpeta y ajusta lo que necesites; sin este archivo,
# docker-compose.yml usa los valores por defecto de la demo.
#
# (Para la ejecución con npm, las variables van en backend/.env y frontend/.env.)

JWT_SECRET=demo-secret-cambiar-en-produccion
JWT_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000
